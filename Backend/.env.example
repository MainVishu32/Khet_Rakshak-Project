NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection. Keep the real value in an ignored .env or secret manager.
DATABASE_URL=postgres://user:password@localhost:5432/khet_rakshak
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Must be the same Firebase project configured in the frontend.
FIREBASE_PROJECT_ID=khet-rakshak

# Prefer Application Default Credentials in production. For local use only,
# optionally provide a service-account JSON string through a secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=
